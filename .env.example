# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to git — only this example file.

# Free API key from https://console.groq.com/keys (no credit card required)
GROQ_API_KEY=gsk_your-key-here

# Optional but recommended: free API key from https://app.tavily.com/
# (1,000 free searches/month, no credit card required)
# If left blank, the agent still works - it just skips external web
# research and relies only on what the user types in.
TAVILY_API_KEY=tvly-your-key-here
